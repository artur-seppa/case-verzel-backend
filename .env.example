NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Gera com: openssl rand -hex 32
COOKIE_SECRET=

# Local (docker compose): postgres://postgres:postgres@localhost:5433/case_verzel
# Supabase: connection string do painel Project Settings > Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/case_verzel

# Local (docker compose): redis://localhost:6380
REDIS_URL=redis://localhost:6380/0

# Gera com: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Gera com: openssl rand -hex 32
TICKET_QR_SECRET=

# Tempo que um assento fica reservado aguardando pagamento antes de ser liberado
RESERVATION_HOLD_TTL=10m

# 'simulated' (padrão, sem dependência externa — cartão terminado em 0002 recusa)
# ou 'stripe' (chamada real à API do Stripe em modo teste)
PAYMENT_GATEWAY=simulated
# Obrigatório apenas se PAYMENT_GATEWAY=stripe. https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
